      "backgroundImage": "https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=1600&q=85",
      "backgroundOverlay": "linear-gradient(135deg, rgba(10,10,10,0.75) 0%, rgba(10,10,10,0.35) 100%)",
      "contentAlign": "left",
      "size": "hero",
