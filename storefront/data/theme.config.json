      "backgroundOverlay": "linear-gradient(135deg, rgba(10,10,10,0.75) 0%, rgba(10,10,10,0.35) 100%)",
      "contentAlign": "left",
      "size": "lg",
      "cta": {
        "label": "Shop Beauty",
        "href": "/category/cosmetics",
        "variant": "outline"
      }
    },

    "secondaryBanner": {
      "enabled": false,
