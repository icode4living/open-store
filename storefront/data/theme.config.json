      "enabled": false,
      "title": "Stay in the loop",
      "subtitle": "Get early access to new arrivals, exclusive offers, and style guides.",
      "placeholder": "Your email address",
      "ctaLabel": "Subscribe",
      "backgroundStyle": "dark"
